        def MjcActuator "left_hip_yaw"
        {
            uniform double[] mjc:biasPrm = [0, -0.55, -0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 10
            uniform double mjc:ctrlRange:min = -10
            uniform double mjc:forceRange:max = 0.96
            uniform double mjc:forceRange:min = -0.96
            uniform double[] mjc:gainPrm = [0.55, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </microduck/Geometry/trunk_base/yaw2roll/left_hip_yaw>
