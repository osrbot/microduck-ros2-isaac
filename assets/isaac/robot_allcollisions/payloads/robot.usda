#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "microduck"
    doc = "Generated from the pinned Pollen Robotics MicroDuck MJCF with Isaac Sim 6.0.1; validated and post-processed by microduck_ros_isaac."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "microduck" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "trunk_base" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "yaw2roll" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_hip_yaw" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "hip_l" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "left_hip_roll" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "upper_leg_left" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_hip_pitch" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "leg" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "left_knee" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }

                            over "ankle_left" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "left_ankle" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "neck" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "neck_pitch" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "neck_pitch_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "head_pitch" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "yaw_roll_motion" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "head_yaw" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "jaw_soft" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "head_roll" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "bearing_roll" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_hip_yaw" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "hip_l_2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_hip_roll" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "upper_leg_right" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_hip_pitch" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "leg_2" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_knee" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }

                            over "ankle_right" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "right_ankle" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
